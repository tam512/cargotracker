<?xml version="1.0" encoding="UTF-8"?>
<tomee>
  <!-- see http://tomee.apache.org/containers-and-resources.html -->

  <!-- JmsApplicationEvents injects a container-default JMSContext (@Inject JMSContext), which
       TomEE resolves through the resource named DefaultJMSConnectionFactory. TomEE does not
       auto-create it, so without this the app fails with:
       javax.naming.NameNotFoundException: Name "Resource/DefaultJMSConnectionFactory" not found.
       The queues themselves are created automatically from the jms-destination entries in web.xml. -->
  <Resource id="Default JMS Resource Adapter" type="ActiveMQResourceAdapter">
    BrokerXmlConfig = broker:(tcp://localhost:61616)?useJmx=false
    ServerUrl = vm://localhost?async=true
  </Resource>
  <Resource id="DefaultJMSConnectionFactory" type="javax.jms.ConnectionFactory">
    ResourceAdapter = Default JMS Resource Adapter
  </Resource>
</tomee>
